# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://euro2:euro2@localhost:5432/euro2

# Numista API v3 — request a free key at https://en.numista.com/api/
NUMISTA_API_KEY=

# eBay Browse API — production keyset from https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Local storage for crawled HTML/JSON cache and downloaded coin images
DATA_DIR=./data

# Identify our crawler politely to HTML sources
USER_AGENT=euro2-core/0.1 (+https://github.com/Rampere-98/euro2-core)

# Signs login tokens and piece certificates: use a long random string
SECRET_KEY=
